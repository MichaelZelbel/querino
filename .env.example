# Frontend (Vite only exposes variables with the VITE_ prefix)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key_here
# Optional: canonical origin for SEO tags; defaults to https://querino.ai
# VITE_SITE_ORIGIN=https://your-domain.example

# Edge function secrets live in Supabase, not in this file:
#   npx supabase secrets set OPENROUTER_API_KEY=... INTERNAL_JOB_SECRET=...
# The full list is in CLAUDE.md under "Environment Variables".
