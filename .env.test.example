# Copy to .env.test (gitignored) and fill in. Real environment variables win
# over anything set here.
#
# You need ONE of the first two. If you already have a Supabase personal access
# token, use that and the suite reads the project's service-role key itself.

SUPABASE_ACCESS_TOKEN=
# SUPABASE_SERVICE_ROLE_KEY=

# A non-admin account on the project. The suite signs in as this user, moves
# its credit balance around, and puts it back. Do not point this at a real
# person's account.
QUERINO_TEST_EMAIL=
QUERINO_TEST_PASSWORD=

# The shared secret machine callers present as X-Internal-Key. Set once Phase 1
# has shipped. While it is empty the suite still checks that strangers are
# refused; it just cannot also check that the real jobs are let through.
# INTERNAL_JOB_SECRET=

# Only if you are pointing the suite at a different project.
# QUERINO_PROJECT_REF=zvuwkffneqxqsihlnfsd
