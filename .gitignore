# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
# nitro build output, since the TanStack migration. Not ignored until
# 2026-08-26, and 152 of its files were committed by a git add -A before that.
.output
.nitro
.tanstack
# Wrangler's working folder. The build writes .wrangler/deploy/config.json (a
# pointer to .output/server/wrangler.json) on every run, and `wrangler dev`
# keeps its local state in .wrangler/state and .wrangler/tmp. Nothing in it is
# source: the pointer was committed once (2026-08-24, with a Windows path) and
# every Linux build rewrote it, leaving the checkout dirty (#74).
.wrangler
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env
.env.local
.env.*.local
.mcp.json

# Security test suite: local credentials, never committed
.env.test
test-results/
playwright-report/
supabase/.temp/

# `deno test` writes this. The repo has never tracked one, and committing it
# would start enforcing a lockfile across all 35 edge functions, which is a
# bigger change than the unit tests that created it.
supabase/functions/deno.lock

__pycache__/
*.pyc
*.pyo
.factory/consumer.json
.factory/backup/
.factory/STOP
.factory/PAUSE
.factory/schedule.log
.factory/schedule-task.xml
.factory/trigger.json
.factory/gate.json
.factory/*.lock
harness/.results/
.factory/holdout/.results/
.env.*
!.env.example
*.pem
secrets.json
credentials.json
.factory/schedule.json
!.env.test.example
